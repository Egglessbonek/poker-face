# Poker Face environment. Copy to .env.local (git-ignored) and fill in what you use.
# Nothing here is required to run the app: with no keys the AI seats play a math-only
# strategy in silence, and everything else (table, tells, rail, reveal) still works.
#
# Read by: src/lib/llm/provider.ts, src/lib/villain/personas.ts, src/app/api/elevenlabs/tts/route.ts


# ─── AI players' brain ────────────────────────────────────────────────────────
# Every AI seat sends the game state, its equity, and the humans' tells to an LLM
# and gets back a JSON action plus a line of table talk.

# Which backend to use: openrouter | gemini | anthropic.
# Defaults to openrouter when OPENROUTER_API_KEY is set, otherwise gemini.
# Only openrouter lets each seat be a different model; the other two use one model for every seat.
LLM_PROVIDER=openrouter

# OpenRouter (recommended). One key, every model. Get it at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Per-seat model overrides. The seat ids and default OpenRouter model ids live in
# src/lib/llm/models.ts (claude, chatgpt, deepseek, gemini, grok, llama, mistral, qwen, kimi).
# Set OPENROUTER_MODEL_<SEAT_ID> to swap the model behind a seat without a code change.
# Browse ids at https://openrouter.ai/models
#OPENROUTER_MODEL_CLAUDE=anthropic/claude-sonnet-5
#OPENROUTER_MODEL_CHATGPT=openai/gpt-5.6-terra
#OPENROUTER_MODEL_DEEPSEEK=deepseek/deepseek-v3.2

# Fallback model when a seat has no id at all (should not happen with the built-in catalog).
#OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Sent to OpenRouter as the HTTP-Referer so requests show up under this app in your dashboard.
# Use the deployed URL in production.
APP_URL=http://localhost:3000

# Direct providers, only used when LLM_PROVIDER is gemini or anthropic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5


# ─── AI players' voice (ElevenLabs text-to-speech) ────────────────────────────
# When a table has voice on, each AI's table talk is spoken aloud on every client via
# POST /api/elevenlabs/tts. Without ELEVENLABS_API_KEY the talk still shows as text bubbles.
# Get a key at https://elevenlabs.io and voice ids from the Voice Library (the "ID" on each voice).
ELEVENLABS_API_KEY=

# TTS model. eleven_flash_v2_5 is the low-latency one; eleven_multilingual_v2 sounds richer but slower.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Voice used by any AI seat that has no voice of its own below.
ELEVENLABS_VOICE_ID=

# One voice per AI seat, keyed by the seat id from src/lib/llm/models.ts (ELEVENLABS_VOICE_<SEAT_ID>).
# Leave any of these blank to fall back to ELEVENLABS_VOICE_ID.
ELEVENLABS_VOICE_CLAUDE=
ELEVENLABS_VOICE_CHATGPT=
ELEVENLABS_VOICE_DEEPSEEK=
ELEVENLABS_VOICE_GEMINI=
ELEVENLABS_VOICE_GROK=
ELEVENLABS_VOICE_LLAMA=
ELEVENLABS_VOICE_MISTRAL=
ELEVENLABS_VOICE_QWEN=
ELEVENLABS_VOICE_KIMI=
