# LLM (AI players' brain). One of: gemini | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ElevenLabs TTS (AI table talk). One voice per persona; ELEVENLABS_VOICE_ID is the fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_VEGA=
ELEVENLABS_VOICE_DUTCH=
ELEVENLABS_VOICE_ADA=
