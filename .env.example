# Poker Face environment. Copy to .env.local (git-ignored) and fill in what you use.
# Nothing here is required to run the app: with no keys the AI seats play a math-only
# strategy in silence, and everything else (table, tells, rail, reveal) still works.
#
# Read by the LLM, voice, and Solana prediction-market integrations.


# ─── AI players' brain ────────────────────────────────────────────────────────
# Every AI seat sends the game state, its equity, and the humans' tells to an LLM
# and gets back a JSON action plus a line of table talk.

# Which backend to use: openrouter | gemini | anthropic.
# Defaults to openrouter when OPENROUTER_API_KEY is set, otherwise gemini.
# Only openrouter lets each seat be a different model; the other two use one model for every seat.
LLM_PROVIDER=openrouter

# OpenRouter (recommended). One key, every model. Get it at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Reasoning effort for AI seats in big pots (low|medium|high). Default low keeps every turn under a few seconds.
AI_BIG_POT_EFFORT=low

# Seats are OpenRouter model ids chosen at table creation (e.g. anthropic/claude-sonnet-5), so
# there is nothing to configure per model here. The regulars pinned in the picker are listed in
# src/lib/llm/models.ts.

# Sent to OpenRouter as the HTTP-Referer so requests show up under this app in your dashboard.
# Use the deployed URL in production.
APP_URL=http://localhost:3000

# Direct providers, only used when LLM_PROVIDER is gemini or anthropic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5


# ─── AI players' voice (ElevenLabs text-to-speech) ────────────────────────────
# When a table has voice on, each AI's table talk is spoken aloud on every client via
# POST /api/elevenlabs/tts. Without ELEVENLABS_API_KEY the talk still shows as text bubbles.
# Get a key at https://elevenlabs.io and voice ids from the Voice Library (the "ID" on each voice).
ELEVENLABS_API_KEY=

# TTS model. eleven_flash_v2_5 is the low-latency one; eleven_multilingual_v2 sounds richer but slower.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Voices are automatic: every provider has a signature voice (src/lib/villain/voices.ts) and a table
# never gives two seats the same voice. Set these only to override:
#   ELEVENLABS_VOICE_<MODEL ID>  e.g. ELEVENLABS_VOICE_ANTHROPIC_CLAUDE_SONNET_5 (non-alphanumerics become _)
#   ELEVENLABS_VOICE_<VENDOR>    e.g. ELEVENLABS_VOICE_OPENAI covers every OpenAI model
#   ELEVENLABS_VOICE_ID          fallback for a provider with no signature voice
#ELEVENLABS_VOICE_ID=
#ELEVENLABS_VOICE_OPENAI=

# Presage runs automatically with the existing camera, in one native child process per player.
SMARTSPECTRA_API_KEY=
# Bound native CPU/memory usage; increase only after measuring the deployment's capacity.
PRESAGE_MAX_SESSIONS=2
# Independent confidence cutoffs (50–100). 70 preserves the existing default.
# Try 60 in a reference-device comparison; never treat coverage as accuracy.
PRESAGE_PULSE_CONFIDENCE=70
PRESAGE_BREATHING_CONFIDENCE=70

# ─── Rail prediction markets (Solana devnet) ─────────────────────────────────
# The host must also enable "Rail predictions" in the table lobby. With these
# blank, spectators still see live market movement in watch-only mode, but no
# wallet can stake. Keep the secret server-only; never prefix it with NEXT_PUBLIC_.

# A JSON array containing all 64 bytes returned by Keypair.secretKey.
SOLANA_TREASURY_SECRET_KEY=
# Optional guard: betting is disabled if this does not match the secret above.
SOLANA_TREASURY_PUBLIC_KEY=
# Server RPC used to verify stakes and send payouts.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Browser RPC used by connected Phantom-compatible wallets.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
