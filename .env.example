# LLM (villain brain). One of: gemini | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ElevenLabs (villain voice + optional conversation)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Per-persona agents (public: used client-side to pick an agent)
NEXT_PUBLIC_ELEVENLABS_AGENT_VEGA=
NEXT_PUBLIC_ELEVENLABS_AGENT_DUTCH=
