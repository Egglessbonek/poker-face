# AI players think through OpenRouter, so each seat can be a different model
# (Claude, ChatGPT, DeepSeek, Gemini, Grok, Llama, Mistral, Qwen, Kimi).
# LLM_PROVIDER defaults to openrouter when OPENROUTER_API_KEY is set.
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
# Override the OpenRouter id behind any seat: OPENROUTER_MODEL_<ID> (ids in src/lib/llm/models.ts)
# OPENROUTER_MODEL_CHATGPT=openai/gpt-5.6-terra
# OPENROUTER_MODEL_CLAUDE=anthropic/claude-sonnet-5
APP_URL=http://localhost:3000

# Direct providers (every AI seat then uses the same model)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ElevenLabs TTS (AI table talk). One voice per model; ELEVENLABS_VOICE_ID is the fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_CLAUDE=
ELEVENLABS_VOICE_CHATGPT=
ELEVENLABS_VOICE_DEEPSEEK=
ELEVENLABS_VOICE_GEMINI=
ELEVENLABS_VOICE_GROK=
ELEVENLABS_VOICE_LLAMA=
ELEVENLABS_VOICE_MISTRAL=
ELEVENLABS_VOICE_QWEN=
ELEVENLABS_VOICE_KIMI=
